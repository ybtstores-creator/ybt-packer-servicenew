<?xml version="1.0" encoding="utf-8"?>
<!--
  Spacing / radius / elevation scale, on a 4dp grid.
  Mirrors the spacing and radius tokens in assets/css/ybt-tokens.css.
-->
<resources>
    <!-- Spacing -->
    <dimen name="space_2">2dp</dimen>
    <dimen name="space_4">4dp</dimen>
    <dimen name="space_6">6dp</dimen>
    <dimen name="space_8">8dp</dimen>
    <dimen name="space_12">12dp</dimen>
    <dimen name="space_16">16dp</dimen>
    <dimen name="space_20">20dp</dimen>
    <dimen name="space_24">24dp</dimen>
    <dimen name="space_32">32dp</dimen>

    <!-- Corner radii -->
    <dimen name="radius_sm">8dp</dimen>
    <dimen name="radius_md">12dp</dimen>
    <dimen name="radius_card">16dp</dimen>
    <dimen name="radius_lg">20dp</dimen>
    <dimen name="radius_pill">999dp</dimen>

    <!-- Elevation (M3 filled surfaces carry a stroke instead of a shadow) -->
    <dimen name="elevation_card">0dp</dimen>
    <dimen name="elevation_sheet">8dp</dimen>

    <!-- Touch target + common sizes -->
    <dimen name="touch_min">48dp</dimen>
    <dimen name="icon_sm">16dp</dimen>
    <dimen name="icon_md">20dp</dimen>
    <dimen name="icon_lg">24dp</dimen>
    <dimen name="avatar_sm">32dp</dimen>
    <dimen name="avatar_md">40dp</dimen>
    <dimen name="divider_thin">1dp</dimen>
</resources>
