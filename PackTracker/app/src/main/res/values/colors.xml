    <color name="tertiary">@color/emerald_500</color>
    <color name="on_tertiary">#FFFFFFFF</color>
    <color name="tertiary_container">@color/emerald_50</color>
    <color name="on_tertiary_container">@color/emerald_800</color>

    <color name="error">#FFDC2626</color>
