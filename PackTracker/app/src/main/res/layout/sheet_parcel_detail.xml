<?xml version="1.0" encoding="utf-8"?>
<!-- Parcel details bottom sheet, shown when a user taps a tracking number. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sheetParcelDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingBottom="20dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/drag_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Parcel Details"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseSheet"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Close"
            app:tint="@color/on_surface_variant" />
    </LinearLayout>

    <!-- Tracking number -->
    <TextView
        android:id="@+id/tvSheetTrackingNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="4dp"
        android:text="YBT-0001"
        android:textColor="@color/green_primary"
        android:textSize="@dimen/text_title"
        android:textStyle="bold" />

    <!-- Status badge -->
    <TextView
        android:id="@+id/tvSheetStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_status_badge"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="Received"
        android:textColor="@color/on_surface_variant"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold" />

    <!-- Description -->
    <TextView
        android:id="@+id/tvSheetDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:text="Description"
        android:textColor="@color/on_surface"
        android:textSize="@dimen/text_body_sm" />

    <!-- Facts grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_fact_box"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvSheetItemCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Items"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/text_micro" />
        </LinearLayout>

        <Space android:layout_width="10dp" android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_fact_box"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvSheetWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weight (kg)"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/text_micro" />
        </LinearLayout>

        <Space android:layout_width="10dp" android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_fact_box"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvSheetMethod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shipping"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/text_micro" />
        </LinearLayout>
    </LinearLayout>

    <!-- Timeline -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:text="TIMELINE"
        android:letterSpacing="0.08"
        android:textColor="@color/on_surface_variant"
        android:textSize="@dimen/text_micro"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="6dp"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_time_dot"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Added"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_body_sm" />
            <TextView
                android:id="@+id/tvSheetDateAdded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/text_body_sm" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="6dp"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_time_dot"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Received at warehouse"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_body_sm" />
            <TextView
                android:id="@+id/tvSheetDateReceived"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/text_body_sm" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="6dp"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_time_dot"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Packed"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_body_sm" />
            <TextView
                android:id="@+id/tvSheetDatePacked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/text_body_sm" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="6dp"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_time_dot"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Completed / Shipped"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_body_sm" />
            <TextView
                android:id="@+id/tvSheetDateCompleted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/text_body_sm" />
        </LinearLayout>
    </LinearLayout>

    <!-- Event history (server-side timeline) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:text="TRACKING HISTORY"
        android:letterSpacing="0.08"
        android:textColor="@color/on_surface_variant"
        android:textSize="@dimen/text_micro"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSheetTimeline"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="6dp"
        android:paddingHorizontal="20dp"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/tvSheetNoTimeline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="6dp"
        android:text="No history recorded yet"
        android:textColor="@color/on_surface_variant"
        android:textSize="@dimen/text_caption"
        android:visibility="gone" />

    <!-- Content images -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="14dp"
        android:text="CONTENT IMAGES"
        android:letterSpacing="0.08"
        android:textColor="@color/on_surface_variant"
        android:textSize="@dimen/text_micro"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSheetImages"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="20dp"
        android:clipToPadding="false"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/tvSheetNoImages"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="6dp"
        android:text="No content images uploaded yet"
        android:textColor="@color/on_surface_variant"
        android:textSize="@dimen/text_caption"
        android:visibility="gone" />
</LinearLayout>
