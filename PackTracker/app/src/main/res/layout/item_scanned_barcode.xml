<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_glass_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <TextView
        android:id="@+id/tvIndex"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text=""
        android:textColor="@color/overlay_text_mid"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvBarcodeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="0000000000"
            android:textColor="@color/white"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFormat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/overlay_text_high"
            android:textSize="@dimen/text_micro" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/white"
            android:textSize="@dimen/text_micro" />

        <TextView
            android:id="@+id/tvDuplicate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Duplicate"
            android:textColor="@color/overlay_pending"
            android:textSize="@dimen/text_micro"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvSaved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saved"
            android:textColor="@color/overlay_success"
            android:textSize="@dimen/text_micro"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvOfflineSaved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saved offline — will sync"
            android:textColor="@color/overlay_text_high"
            android:textSize="@dimen/text_micro"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Failed to save"
            android:textColor="@color/overlay_error"
            android:textSize="@dimen/text_micro"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressSaving"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="8dp"
        android:indeterminateTint="@color/white"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btnRetry"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Retry"
        android:src="@drawable/ic_refresh"
        android:visibility="gone"
        app:tint="@color/white" />
</LinearLayout>
