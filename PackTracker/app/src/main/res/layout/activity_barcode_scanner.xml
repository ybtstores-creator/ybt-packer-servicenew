<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scanner_overlay">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Scan status + value -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvScanStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_pill"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="Align barcode in the box"
            android:textColor="@color/white"
            android:textSize="@dimen/text_body_sm" />

        <TextView
            android:id="@+id/tvBarcodeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_glass_pill"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text=""
            android:textColor="@color/white"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvFormat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="@color/overlay_text_high"
            android:textSize="@dimen/text_micro" />

        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="@color/overlay_error"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:id="@+id/tvDuplicate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="@color/overlay_warn"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:id="@+id/tvSaved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="@color/white"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:id="@+id/tvIndex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="@color/white"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvNetworkStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="150dp"
        android:background="@drawable/bg_glass_pill"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="Online"
        android:textColor="@color/white"
        android:textSize="@dimen/text_micro" />

    <!-- Offline banner -->
    <LinearLayout
        android:id="@+id/offlineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="180dp"
        android:background="@color/offline_banner"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvOfflineHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Offline — scans saved locally"
            android:textColor="@color/white"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:id="@+id/tvOfflineSaved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text=""
            android:textColor="@color/white"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <!-- Pending sync pill -->
    <TextView
        android:id="@+id/tvPendingSyncCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_glass_pill"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="0 pending"
        android:textColor="@color/white"
        android:textSize="@dimen/text_caption" />

    <!-- Batch badge + confirm action shown during a batch scan session -->
    <FrameLayout
        android:id="@+id/batchBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@drawable/bg_glass_pill"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BATCH"
            android:textColor="@color/white"
            android:textSize="@dimen/text_micro"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/btnConfirm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_glass_pill"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="Confirm batch"
        android:textColor="@color/white"
        android:textSize="@dimen/text_body_sm"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Scanned items list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvScannedItems"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="140dp"
        android:background="@color/overlay_scrim_soft"
        android:clipToPadding="false"
        android:padding="8dp" />

    <!-- Bottom controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/scanner_overlay"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvBatchCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 scanned this session"
            android:textColor="@color/white"
            android:textSize="@dimen/text_caption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:src="@drawable/ic_close"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnGallery"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Gallery"
                android:src="@drawable/ic_gallery"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnTorch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Torch"
                android:src="@drawable/ic_flash_off"
                app:tint="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManualEntry"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:text="Type" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSyncPending"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="Sync" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressSaving"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- Animated scan line -->
        <View
            android:id="@+id/scanningLine"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="8dp"
            android:background="@color/scanner_accent"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
