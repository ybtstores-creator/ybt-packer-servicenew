<?xml version="1.0" encoding="utf-8"?>
<!-- One row in the parcel sheet's tracking-history timeline. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/ivTimelineDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginTop="5dp"
        android:src="@drawable/ic_time_dot"
        android:contentDescription="@null"
        app:tint="@color/on_surface_variant" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTimelineTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Received"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_body_sm"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTimelineMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:id="@+id/tvTimelineMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/text_micro" />
    </LinearLayout>
</LinearLayout>
