# Disable directory browsing
Options -Indexes

# Allow only APK downloads, deny all other files
<FilesMatch "(?i)\.(?!apk$)[^.]+$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>
